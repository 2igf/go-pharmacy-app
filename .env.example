NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=mysql://REPLACE_USER:REPLACE_PASSWORD@127.0.0.1:3306/go_pharmacy_beta
PRIVATE_BETA=true
BETA_ALLOWED_EMAILS=REPLACE_INVITED_EMAILS_COMMA_SEPARATED
BETA_INVITE_SECRET=REPLACE_WITH_CRYPTOGRAPHIC_RANDOM_SECRET_32_OR_MORE_CHARACTERS
# Only set to the actual reverse proxy IP/CIDR when deployed behind HTTPS.
TRUST_PROXY=
# One-time commands only; remove secrets and confirmations after use.
CONFIRM_FICTIONAL_SEED=no
CONFIRM_CREATE_ADMIN=no
ADMIN_EMAIL=REPLACE_ADMIN_EMAIL
ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_LONG_PASSWORD
## Android API boundary: enable only behind trusted HTTPS with this branch's backend.
ANDROID_API_ENABLED=false
# Optional public build-time endpoint (origin only); never put a password/token here.
# VITE_ANDROID_API_ORIGIN=https://your-beta-server.example
